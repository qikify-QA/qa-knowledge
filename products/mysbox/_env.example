# Biến env của người test mysbox, instance staging. Chép thành .env.mysbox rồi điền giá trị, không commit.
# File này chỉ có tên biến. Dùng biến nào cho việc gì: _product-guide.md mục 3.
# Chưa có biến cho: email/password Shopify admin (session do operator bàn giao).

# Host
MYS_SHOPIFY_ADMIN_APP_URL=
MYS_API_BASE=

# Store test
MYS_STORE_HANDLE=
MYS_STORE_DOMAIN=
MYS_STOREFRONT_PASSWORD=

# Hộp thư QA nhận email đơn test và magic link
MYS_TEST_BUYER_EMAIL=
