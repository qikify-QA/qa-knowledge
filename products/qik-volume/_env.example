# Biến env của người test qik-volume, instance staging. Chép thành .env.qik-volume rồi điền giá trị, không commit.
# File này chỉ có tên biến. Dùng biến nào cho việc gì: _product-guide.md mục 3.
# Chưa có biến cho: email/password Shopify admin (session do operator bàn giao).

# Host
QVL_SHOPIFY_ADMIN_APP_URL=
QVL_API_BASE=

# Store test
QVL_STORE_HANDLE=
QVL_STORE_DOMAIN=
QVL_STOREFRONT_PASSWORD=
